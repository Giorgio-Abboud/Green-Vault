import pytest
from fastapi.testclient import TestClient
from datetime import datetime, timezone, timedelta, time

from analyzer.cmd.main import app

client = TestClient(app) #to create a test client for the FastAPI app

# A valid payload to use as a base for tests
VALID_PAYLOAD = {
    "timestamp": "2025-06-03T10:15:37-04:00",
    "price": 190.12,
    "quantity": 150,
    "side": "buy",
    "symbol": "AAPL",
    "request": "analyze",
}

# Helper to post JSON payload and return response
def post(payload):
    return client.post("/calculate", json=payload)

# Sends a valid payload and expects success
def test_valid_payload_succeeds():
    r = post(VALID_PAYLOAD)
    assert r.status_code == 200
    body = r.json()
    assert body.get("ok") is True

#TESTS that have "mark.xfail" because the validation is not yet implemented
